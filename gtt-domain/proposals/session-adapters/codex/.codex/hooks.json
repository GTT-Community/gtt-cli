{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/gtt-session-start.sh",
            "timeout": 60,
            "statusMessage": "Loading GTT session memory (operational-only)",
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
