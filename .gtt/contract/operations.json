    "recovery.restore": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["recovery", "restore"], "args": [ { "name": "snapshot", "type": "path", "flag": "--snapshot", "required": true }, { "name": "from", "type": "path", "flag": "--from" }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },

