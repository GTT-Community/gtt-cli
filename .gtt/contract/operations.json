    "artifact.next-id": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["next-id", "--json"], "args": [ { "name": "kind", "type": "enum", "values": ["adr", "epic", "story"], "flag": "--kind", "required": true }, { "name": "requested", "type": "id", "flag": "--requested" } ], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "next-id" } },
    "maintain": { "version": 1, "implementation": ".gtt/scripts/gtt-maintain.sh", "argv": [], "args": [ { "name": "verbose", "type": "bool", "flag": "--verbose" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },
    "methodology.profile.get": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["profile", "get", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "methodology-profile" } },
    "methodology.profile.set": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["profile", "set"], "args": [ { "name": "profile", "type": "enum", "values": ["light", "medium", "hard", "team"], "flag": "--profile" }, { "name": "language", "type": "enum", "values": ["en", "es"], "flag": "--language" }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },

    "source.select": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["source", "select"], "args": [ { "name": "path", "type": "path", "flag": "--path", "required": true }, { "name": "type", "type": "enum", "values": ["design-document", "requirements", "architecture", "brief", "other"], "flag": "--type", "required": true }, { "name": "version", "type": "string", "flag": "--version" }, { "name": "by", "type": "string", "flag": "--by" }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },
    "source.list": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["source", "list", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "initial-sources" } },

    "validation.run": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["validation", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "validation" } },
    "contract.check": { "version": 1, "implementation": ".gtt/scripts/gtt-contract.sh", "argv": ["check", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "contract-check" } },
    "status": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["status", "--json"], "args": [ { "name": "with_validation", "type": "bool", "flag": "--with-validation" } ], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "status" } },
    "freeze": { "version": 1, "implementation": ".gtt/scripts/gtt-freeze.sh", "argv": [], "args": [], "mutates": true, "human_authority": true, "outputs": { "format": "text" } },
    "session-context": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["session", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "session" } },
    "session-context.text": { "version": 1, "implementation": ".gtt/scripts/gtt-session-context.sh", "argv": [], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "text" } },

    "export-policy": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["export-policy", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "export-policy" } },
    "clean.plan": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["clean-plan", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "clean-plan" } },

