{
  "schema": 1,
  "contract_version": 1,
  "notice": "Bootstrap-owned operation registry: logical operation -> trusted implementation, fixed argv, typed arguments. The CLI executes declared operations only (gtt-contract.sh run <op> name=value ...): never a shell string, never a path outside .gtt/scripts/. Implementations may change language without a CLI change. Mutating operations are dry runs unless `apply` is true; operations with human_authority need confirmed_by_human=true from the CLI. There is deliberately no unfreeze operation.",
  "argument_types": {
    "id": "identifier: letters, digits, dot, dash, underscore; no leading dash",
    "string": "single-line text without control characters; no leading dash",
    "path": "file or directory path without control characters; no leading dash",
    "path-list": "comma-separated paths, passed as separate arguments",
    "list": "comma-separated identifiers, passed as one comma-separated value",
    "enum": "one of `values`",
    "bool": "true | false; a flag when true"
  },
  "operations": {
    "project.detect": { "version": 1, "implementation": ".gtt/scripts/gtt-project.sh", "argv": ["detect", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "project-detection" } },

    "ade.registry": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["list", "--json"], "args": [ { "name": "from", "type": "path", "flag": "--from" } ], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "ade-registry" } },
    "ade.detect": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["detect", "--json"], "args": [ { "name": "from", "type": "path", "flag": "--from" } ], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "ade-detection" } },
    "ade.state": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["state", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "ade-state" } },
    "ade.owned": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["owned", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "ade-owned" } },
    "ade.validate": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["validate", "--json"], "args": [], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "ade-validation" } },
    "ade.install": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["install"], "args": [ { "name": "from", "type": "path", "flag": "--from", "required": true }, { "name": "participating", "type": "list", "flag": "--participating", "required": true }, { "name": "primary", "type": "id", "flag": "--primary", "required": true }, { "name": "reinclude", "type": "list", "flag": "--reinclude" }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },
    "ade.adopt": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["adopt"], "args": [ { "name": "participating", "type": "list", "flag": "--participating" }, { "name": "primary", "type": "id", "flag": "--primary" }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },
    "ade.set-primary": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["set-primary"], "args": [ { "name": "ade", "type": "id", "positional": true, "required": true }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },
    "ade.update": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["update"], "args": [ { "name": "from", "type": "path", "flag": "--from", "required": true }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },
    "ade.remove": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["remove"], "args": [ { "name": "ades", "type": "list", "positional": true }, { "name": "all", "type": "bool", "flag": "--all" }, { "name": "new_primary", "type": "id", "flag": "--new-primary" }, { "name": "include_modified", "type": "bool", "flag": "--include-modified" }, { "name": "assume_registry_owned", "type": "bool", "flag": "--assume-registry-owned" }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },
    "ade.record": { "version": 1, "implementation": ".gtt/scripts/gtt-ade.sh", "argv": ["record"], "args": [ { "name": "ade", "type": "id", "positional": true, "required": true }, { "name": "paths", "type": "path-list", "positional": true, "required": true }, { "name": "apply", "type": "bool", "flag": "--apply" } ], "mutates": true, "human_authority": false, "outputs": { "format": "text" } },

