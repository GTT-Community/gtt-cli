    "template.show": { "version": 1, "implementation": ".gtt/scripts/gtt-template.sh", "argv": ["show", "--json"], "args": [ { "name": "id", "type": "id", "positional": true, "required": true }, { "name": "from", "type": "path", "flag": "--from" } ], "mutates": false, "human_authority": false, "outputs": { "format": "json", "contract": "template" } },
