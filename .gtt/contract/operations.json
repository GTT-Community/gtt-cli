    "query": { "version": 1, "implementation": ".gtt/scripts/gtt-query.sh", "argv": [], "args": [ { "name": "term", "type": "string", "positional": true, "required": true }, { "name": "show", "type": "bool", "flag": "--show" }, { "name": "deep", "type": "bool", "flag": "--deep" } ], "mutates": false, "human_authority": false, "outputs": { "format": "text" } },
    "query.governance": { "version": 1, "implementation": ".gtt/scripts/gtt-query.sh", "argv": ["--governance"], "args": [ { "name": "kind", "type": "enum", "values": ["open", "blocking", "resolved", "conflicts", "sources", "agreements"], "positional": true, "required": true } ], "mutates": false, "human_authority": false, "outputs": { "format": "text" } }
